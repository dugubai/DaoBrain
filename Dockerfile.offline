# 从已准备的本地基础镜像与Linux wheel构建；--network=none验证真正无网络依赖。
# 示例：docker build --network=none -f Dockerfile.offline -t daobrain-app:dev .
FROM node:22-bookworm-slim AS node-test-runtime
FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY requirements.txt requirements-linux.lock.txt /app/
# wheel必须在目标Linux生成或逐项核验完整，Mac跨平台解析曾漏greenlet。
COPY daobrain39-wheels /opt/wheels
RUN pip install --no-index --find-links=/opt/wheels -r requirements.txt -c requirements-linux.lock.txt && pip check
# 只为门户JavaScript回归提供Node，避免该项在第一台验收中被跳过。
COPY --from=node-test-runtime /usr/local/bin/node /usr/local/bin/node
COPY . /app
RUN groupadd --gid 10001 daobrain && useradd --uid 10001 --gid 10001 --no-create-home daobrain
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "gateway.main:app", "--host", "0.0.0.0", "--port", "8000"]
