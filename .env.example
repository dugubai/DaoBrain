# ---- 通用 ----
DAOBRAIN_ENV=dev
LOG_LEVEL=INFO

# ---- 数据/中间件连接（compose 内用服务名） ----
POSTGRES_DSN=postgresql+psycopg://daobrain:daobrain@postgres:5432/daobrain
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# ---- 模块间调用地址（compose 内网） ----
GATEWAY_URL=http://gateway:8000
ORCHESTRATOR_URL=http://agent_orchestrator:8002
RAG_PUBLIC_URL=http://rag_public:8003
HYBRID_IFACE_URL=http://hybrid_iface:8004
EXTERNAL_MODEL_URL=http://external_model:8005
LOCAL_MODEL_URL=http://local_model:8006
RAG_GREEN_URL=http://rag_green:8007
RAG_RED_URL=http://rag_red:8008
REDLINE_GATE_URL=http://redline_gate:8009
OUTPUT_VERIFY_URL=http://output_verify:8010
DAOBRAIN_TUNED_URL=http://daobrain_tuned:8011
CORPUS_KB_URL=http://corpus_kb:8012
CARD_ANNOTATOR_URL=http://card_annotator:8013
OCR_URL=http://ocr:8014

# ---- 红/绿区与外部模型开关（模拟隔离） ----
EXTERNAL_MODEL_MODE=stub            # live当前明确拒绝，尚未接入真实API
EXTERNAL_MODEL_API_KEY=
EXTERNAL_MODEL_BASE_URL=
ALLOW_EXTERNAL_STUB=true
LOCAL_MODEL_BACKEND=stub            # 模拟默认；安装模型后可启用ollama
LOCAL_MODEL_NAME=qwen2.5:3b
OLLAMA_URL=http://ollama:11434
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_OUTPUT_TOKENS=256
# compose.cpu.yml集中覆盖以下参数，不需把实际密钥复制到模型下载容器。
GATEWAY_GREEN_BACKEND=external_stub
MODEL_OUTPUT_PROTOCOL=copy
MODEL_CONTEXT_TOKENS=4096
MODEL_CPU_THREADS=2
PUBLIC_DEMO_BACKEND=external_stub
PUBLIC_DEMO_MODEL_NAME=qwen2.5:0.5b

# 运行 scripts/init_dev_env.py 生成随机密钥，禁止提交实际.env
API_KEY=
INTERNAL_API_KEY=
APPROVAL_SECRET=
POSTGRES_PASSWORD=
MAX_REQUESTS_PER_MINUTE=30

# ---- 费用/迭代限额 ----
MAX_TOKENS_PER_TASK=8000
MAX_ITERATIONS_PER_TASK=6
MAX_COST_CNY_PER_TASK=0.50
DAILY_BUDGET_CNY=50.00
