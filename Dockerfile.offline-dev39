FROM node:22-bookworm-slim AS node-test-runtime
FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY requirements.txt /app/requirements.txt
COPY daobrain39-wheels /opt/wheels
RUN pip install --no-index --find-links=/opt/wheels -r /app/requirements.txt
COPY --from=node-test-runtime /usr/local/bin/node /usr/local/bin/node
COPY . /app
RUN groupadd --gid 10001 daobrain && useradd --uid 10001 --gid 10001 --no-create-home daobrain
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "gateway.main:app", "--host", "0.0.0.0", "--port", "8000"]
